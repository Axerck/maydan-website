---
import Layout from "./Layout.astro";

const { frontmatter } = Astro.props;
const locale = Astro.currentLocale || "it";
const isEn = locale === "en";

const dateFormat = isEn ? "en-GB" : "it-IT";
const backLinkText = isEn ? "← Back to activities" : "← Torna alle attività";
const backLinkUrl = isEn ? "/en/attivita" : "/it/attivita";
const downloadLabel = isEn ? "Download (PDF)" : "Scarica (PDF)";

type PdfAttachment = { titolo: string; url: string; descrizione?: string };
type ImageAttachment = { titolo?: string; url: string; alt?: string };
type CtaLink = { url: string; label: string };

const pdfAttachments: PdfAttachment[] = frontmatter.pdf_attachments || [];
const imageGallery: ImageAttachment[] = frontmatter.image_gallery || [];
const ctaLink: CtaLink | undefined = frontmatter.cta_link;
---

<Layout
    title={`${frontmatter.title} | ${isEn ? "Activities" : "Attività"}`}
    description={frontmatter.description || frontmatter.title}
    image={frontmatter.cover || "/logo.png"}
    ogType="article"
>
    <div class="activity-container">
        <div class="activity-header">
            <div class="activity-date">
                {
                    new Date(frontmatter.date).toLocaleDateString(dateFormat, {
                        year: "numeric",
                        month: "long",
                        day: "numeric",
                    })
                }
            </div>
            <h1 class="activity-title">{frontmatter.title}</h1>
            {
                frontmatter.cover && !frontmatter.hide_cover && (
                    <a
                        href={frontmatter.cover}
                        download
                        class="cover-download-link"
                    >
                        <img
                            src={frontmatter.cover}
                            alt={frontmatter.title}
                            class="activity-cover"
                        />
                    </a>
                )
            }
        </div>

        {
            ctaLink && (
                <div class="activity-cta">
                    <a
                        href={ctaLink.url}
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        {ctaLink.label} &rarr;
                    </a>
                </div>
            )
        }

        <div class="activity-content">
            <slot />
        </div>

        {
            imageGallery.length > 0 && (
                <div class="image-gallery">
                    {imageGallery.map((img) => (
                        <div class="image-item">
                            {img.titolo && <h3>{img.titolo}</h3>}
                            <a href={img.url} download>
                                <img src={img.url} alt={img.alt || img.titolo || ""} />
                            </a>
                        </div>
                    ))}
                </div>
            )
        }

        {
            pdfAttachments.length > 0 && (
                <div class="downloads-section">
                    {pdfAttachments.map((pdf) => (
                        <div class="download-item">
                            <h3>{pdf.titolo}</h3>
                            {pdf.descrizione && (
                                <p class="download-description">{pdf.descrizione}</p>
                            )}
                            <a
                                href={pdf.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="pdf-link"
                            >
                                <span class="icon">📄</span> {downloadLabel}
                            </a>
                        </div>
                    ))}
                </div>
            )
        }

        {
            ctaLink && (
                <div class="activity-cta activity-cta-bottom">
                    <a
                        href={ctaLink.url}
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        {ctaLink.label} &rarr;
                    </a>
                </div>
            )
        }

        <div class="activity-footer">
            <a href={backLinkUrl} class="back-link">{backLinkText}</a>
        </div>
    </div>
</Layout>

<style>
    .activity-container {
        max-width: 800px;
        margin: 0 auto;
        padding: 2rem 1rem;
    }

    .activity-header {
        margin-bottom: 3rem;
        text-align: left;
    }

    .activity-date {
        font-size: 0.9rem;
        color: #666;
        margin-bottom: 0.5rem;
        font-family: var(--font-sans, sans-serif);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .activity-title {
        font-family: "Palatino Linotype", "Book Antiqua", Palatino, serif;
        font-size: 2.5rem;
        line-height: 1.2;
        margin-bottom: 2rem;
        color: #333;
    }

    .activity-cover {
        width: 100%;
        height: auto;
        border-radius: 4px;
        margin-top: 1.5rem;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

    .activity-content {
        font-family: "Palatino Linotype", "Book Antiqua", Palatino, serif;
        font-size: 1.15rem;
        line-height: 1.8;
        color: #222;
        margin-bottom: 4rem;
    }

    .activity-content :global(h2) {
        font-size: 1.5rem;
        margin-top: 2rem;
        margin-bottom: 1rem;
    }

    .activity-content :global(p) {
        margin-bottom: 1.5rem;
    }

    .activity-content :global(a) {
        color: var(--primary-color, #0056b3);
        text-decoration: underline;
    }

    /* CTA link block */
    .activity-cta {
        margin: 1.5rem 0;
    }
    .activity-cta-bottom {
        margin-top: 3rem;
    }
    .activity-cta a {
        font-family: var(--font-sans, sans-serif);
        font-size: 1.05rem;
        font-weight: 500;
        color: #333;
        text-decoration: none;
        letter-spacing: 0.02em;
        transition: color 0.2s;
    }
    .activity-cta a:hover {
        color: #000;
    }

    /* Image gallery */
    .image-gallery {
        display: flex;
        gap: 2rem;
        margin: 2rem 0 3rem;
        flex-wrap: wrap;
    }
    .image-item {
        flex: 1;
        min-width: 300px;
        text-align: center;
    }
    .image-item h3 {
        margin-bottom: 0.5rem;
        font-size: 1.2rem;
        font-family: var(--font-sans, sans-serif);
        color: #444;
    }
    .image-gallery img {
        width: 100%;
        height: auto;
        border-radius: 4px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        transition: transform 0.2s;
    }
    .image-gallery img:hover {
        transform: scale(1.02);
    }

    /* PDF downloads */
    .downloads-section {
        display: flex;
        flex-direction: column;
        gap: 3rem;
        margin: 3rem 0;
    }
    .download-item {
        text-align: center;
    }
    .download-item h3 {
        margin-bottom: 1rem;
        font-family: var(--font-sans, sans-serif);
        font-size: 1.2rem;
        color: #444;
    }
    .download-description {
        margin-bottom: 1rem;
        color: #555;
        font-style: italic;
    }
    .pdf-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 1rem 2rem;
        background-color: #f5f5f5;
        border: 1px solid #ddd;
        border-radius: 4px;
        color: #333;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.2s;
    }
    .pdf-link:hover {
        background-color: #eee;
        border-color: #ccc;
        transform: translateY(-2px);
    }
    .pdf-link .icon {
        font-size: 1.2rem;
    }

    .activity-footer {
        border-top: 1px solid #eee;
        padding-top: 2rem;
        margin-top: 3rem;
    }

    .back-link {
        font-family: var(--font-sans, sans-serif);
        text-decoration: none;
        color: #555;
        font-weight: 500;
        transition: color 0.2s;
    }

    .back-link:hover {
        color: #000;
    }
</style>
