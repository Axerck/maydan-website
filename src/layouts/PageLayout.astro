---
import Layout from "./Layout.astro";

const { frontmatter } = Astro.props;
const locale = Astro.currentLocale || "it";
const isEn = locale === "en";

const homeLinkText = isEn ? "← Back to home" : "← Torna alla home";
const homeLinkUrl = isEn ? "/en/" : "/it/";
---

<Layout
    title={`${frontmatter.title} | ${isEn ? "Maydan Journal" : "Rivista Maydan"}`}
    description={frontmatter.description || frontmatter.title}
    image={frontmatter.cover || "/logo.png"}
    ogType="article"
>
    <article class="page-container">
        <header class="page-header">
            <h1 class="page-title">{frontmatter.title}</h1>
            {frontmatter.cover && !frontmatter.hide_cover && (
                <div class="page-cover">
                    <img src={frontmatter.cover} alt={frontmatter.title} />
                </div>
            )}
        </header>

        <div class="page-content">
            <slot />
        </div>

        <div class="page-footer">
            <a href={homeLinkUrl} class="home-link">{homeLinkText}</a>
        </div>
    </article>
</Layout>

<style>
    .page-container {
        max-width: 800px;
        margin: 3rem auto;
        padding: 0 1rem;
    }

    .page-header {
        margin-bottom: 3rem;
    }

    .page-title {
        font-family: Palatino, "Palatino Linotype", "Book Antiqua", serif;
        font-size: 2.5rem;
        line-height: 1.2;
        margin: 0 0 1.5rem;
        color: #111;
    }

    .page-cover {
        margin-top: 1.5rem;
    }

    .page-cover img {
        width: 100%;
        height: auto;
        display: block;
        border-radius: 4px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

    .page-content {
        font-size: 1.05rem;
        line-height: 1.7;
    }

    .page-content :global(h2) {
        font-family: Palatino, "Palatino Linotype", "Book Antiqua", serif;
        font-size: 1.5rem;
        margin-top: 2.5rem;
        margin-bottom: 1rem;
        color: #000;
    }

    .page-content :global(h3) {
        font-size: 1.2rem;
        margin-top: 1.5rem;
        margin-bottom: 0.5rem;
    }

    .page-content :global(p) {
        margin-bottom: 1.2rem;
    }

    .page-content :global(a) {
        color: #000;
        text-decoration: underline;
    }

    .page-content :global(a:hover) {
        color: #555;
    }

    .page-content :global(img) {
        max-width: 100%;
        height: auto;
        display: block;
        margin: 2rem auto;
        border-radius: 4px;
    }

    .page-content :global(blockquote) {
        border-left: 3px solid #ddd;
        padding-left: 1rem;
        margin-left: 0;
        font-style: italic;
        color: #555;
    }

    .page-content :global(ul),
    .page-content :global(ol) {
        margin-left: 1.5rem;
        margin-bottom: 1.2rem;
    }

    .page-content :global(li) {
        margin-bottom: 0.4rem;
    }

    .page-footer {
        margin-top: 4rem;
        padding-top: 2rem;
        border-top: 1px solid #eee;
    }

    .home-link {
        font-size: 0.9rem;
        color: #666;
        text-decoration: none;
    }

    .home-link:hover {
        color: #000;
        text-decoration: underline;
    }
</style>
