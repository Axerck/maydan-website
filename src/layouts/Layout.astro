---
import "../styles/custom.css";
import { ui } from "../data/ui";
import { getRelativeLocaleUrl } from "astro:i18n";
import { Instagram, Facebook } from "lucide-react";

interface Props {
	title?: string;
	description?: string;
	image?: string;
	ogType?: string;
}

const {
	title = "Maydan – Rivista sui mondi arabi, semitici e islamici",
	description = "Sito ufficiale della rivista accademica Maydan, dedicato agli studi sui mondi arabi, semitici e islamici.",
	image = "/logo.png",
	ogType = "website",
} = Astro.props;
const currentLocale = Astro.currentLocale || "it";
const year = new Date().getFullYear();

const t = currentLocale in ui ? ui[currentLocale as keyof typeof ui] : ui.it;

// Helper to get localized path
const tPath = (path: string) => getRelativeLocaleUrl(currentLocale, path);

// Helper to switch language
const switchLang = (targetLang: string) => {
	const currentPath = Astro.url.pathname;
	// Remove the current locale prefix (e.g. /it/ or /en/)
	const pathWithoutLocale =
		currentPath.replace(`/${currentLocale}`, "") || "/";
	return getRelativeLocaleUrl(targetLang, pathWithoutLocale);
};
// Make canonical dynamic based on current request origin, but strip 'www.'
const originUrl = new URL(Astro.url.pathname, Astro.url.origin);
originUrl.hostname = originUrl.hostname.replace(/^www\./, "");
const canonicalURL = originUrl;
const alternateIt = new URL(switchLang("it"), originUrl.origin);
const alternateEn = new URL(switchLang("en"), originUrl.origin);
---

<!doctype html>
<html lang={currentLocale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link
			rel="icon"
			type="image/svg+xml"
			href="/favicon/favicon_logo.svg"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta
			name="robots"
			content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
		/>

		<!-- SEO Basics -->
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<link rel="alternate" hreflang="it" href={alternateIt} />
		<link rel="alternate" hreflang="en" href={alternateEn} />
		<link rel="alternate" hreflang="x-default" href={alternateIt} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={Astro.url.href} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, Astro.url)} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url.href} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL(image, Astro.url)} />
	</head>
	<body>
		<!-- Skip link -->
		<a class="skip-link" href="#contenuto">Vai al contenuto</a>

		<!-- HEADER -->
		<header class="site-header">
			<div class="header-top-bar">
				<!-- Switch lingua -->
				<div class="lang-switch">
					<a
						href={switchLang("it")}
						class={`lang ${currentLocale === "it" ? "lang-active" : ""}`}
						>🇮🇹 IT</a
					>
					<a
						href={switchLang("en")}
						class={`lang ${currentLocale === "en" ? "lang-active" : ""}`}
						>🇬🇧 EN</a
					>
				</div>
			</div>

			<div class="header-main">
				<div class="site-logo">
					<a href={tPath("/")}>
						<img
							src="/logo_palestina/maydan.svg"
							alt="Maydan Logo"
							class="logo-img"
						/>
					</a>
				</div>

				<button id="menu-toggle" class="menu-toggle" aria-label="Menu">
					<span class="hamburger-box">
						<span class="hamburger-inner"></span>
					</span>
				</button>

				<nav
					id="main-nav"
					class="main-nav"
					aria-label="Menu principale"
				>
					<ul>
						<li><a href={tPath("/chi-siamo")}>{t.nav.about}</a></li>
						<li>
							<a href={tPath("/call-e-linee-guida")}
								>{t.nav.calls}</a
							>
						</li>
						<li>
							<a href={tPath("/pubblicazioni")}>{t.nav.issues}</a>
						</li>
						<li>
							<a href={tPath("/comitato-editoriale")}
								>{t.nav.editorial_board}</a
							>
						</li>
						<li>
							<a href={tPath("/comitato-scientifico")}
								>{t.nav.scientific_board}</a
							>
						</li>
						<li>
							<a href={tPath("/attivita")}>{t.nav.activities}</a>
						</li>
						<li>
							<a href={tPath("/contatti")}>{t.nav.contacts}</a>
						</li>
					</ul>
				</nav>
			</div>
		</header>

		<script>
			const toggle = document.getElementById("menu-toggle");
			const nav = document.getElementById("main-nav");
			const header = document.querySelector(".site-header");

			if (toggle && nav) {
				toggle.addEventListener("click", () => {
					nav.classList.toggle("nav-open");
					toggle.classList.toggle("is-active");
				});
			}

			// Scroll detection for sticky header
			window.addEventListener("scroll", () => {
				if (window.scrollY > 100) {
					header?.classList.add("is-scrolled");
				} else {
					header?.classList.remove("is-scrolled");
				}
			});
		</script>

		<!-- CONTENUTO PRINCIPALE -->
		<main id="contenuto" class="site-main">
			<slot />
		</main>

		<!-- FOOTER -->
		<footer class="site-footer">
			<div class="footer-inner">
				<div class="footer-text">
					<p>Editore: Giulia Gozzini, Firenze</p>
					<p>ISSN 2785-6976</p>
					<p>&copy; <span id="year">{year}</span> Maydan</p>
				</div>
				<div class="social-links">
					<a
						href="https://www.instagram.com/rivistamaydan/"
						target="_blank"
						aria-label="Instagram"
						class="social-icon"
					>
						<Instagram size={24} />
					</a>
					<a
						href="https://www.facebook.com/RivistaMaydan"
						target="_blank"
						aria-label="Facebook"
						class="social-icon"
					>
						<Facebook size={24} />
					</a>
				</div>
			</div>
		</footer>
	</body>
</html>
