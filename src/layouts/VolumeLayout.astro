---
import Layout from "./Layout.astro";
const { frontmatter } = Astro.props;

const locale = Astro.currentLocale || "it";
const isEn = locale === "en";

const labels = isEn
  ? {
      downloadFull: "Download Full Volume",
      pdf: "Download PDF",
      preface: "Preface",
      editorial: "Editorial",
      articles: "Articles",
      workingPapers: "Working Papers",
      reviews: "Reviews",
      defaultEditorialTitle: "Editorial",
      defaultPrefaceTitle: "Preface",
    }
  : {
      downloadFull: "Download Full Volume",
      pdf: "Scarica PDF",
      preface: "Prefazione",
      editorial: "Editoriale",
      articles: "Articoli",
      workingPapers: "Working paper",
      reviews: "Recensioni",
      defaultEditorialTitle: "Editoriale",
      defaultPrefaceTitle: "Prefazione",
    };

type Entry = { titolo?: string; autore?: string; pdf: string };

function inlineMd(text: string): string {
  return text.replace(/\*([^*]+)\*/g, "<em>$1</em>");
}

const prefazione: Entry[] = frontmatter.prefazione || [];
const editoriale: Entry[] = frontmatter.editoriale || [];
const articoli: Entry[] = frontmatter.articoli || [];
const workingPaper: Entry[] = frontmatter.working_paper || [];
const recensioni: Entry[] = frontmatter.recensioni || [];
---

<Layout
  title={`${frontmatter.title} - Rivista Maydan`}
  description={frontmatter.description || frontmatter.title}
  image={frontmatter.cover || "/logo.png"}
  ogType="article"
>
  <div class="volume-container">
    <div class="volume-grid">
      <!-- Left Column: Cover & Action -->
      <aside class="volume-sidebar">
        <div class="volume-cover-wrapper">
          <img
            src={frontmatter.cover}
            alt={`Copertina ${frontmatter.title}`}
            class="volume-cover-img"
          />
        </div>

        {
          frontmatter.pdf_full_link && (
            <div class="volume-action">
              <a
                href={frontmatter.pdf_full_link}
                class="btn-download-full"
                target="_blank"
                rel="noopener noreferrer"
              >
                {labels.downloadFull}
              </a>
            </div>
          )
        }
      </aside>

      <!-- Right Column: Content -->
      <main class="volume-main">
        <header class="volume-header-detail">
          <span class="volume-year-label">{frontmatter.year}</span>
          <h1 class="volume-title-main">{frontmatter.title}</h1>
          <p class="volume-description-main">{frontmatter.description}</p>
        </header>

        <div class="volume-toc-content">
          {
            prefazione.length > 0 && (
              <section>
                <h2>{labels.preface}</h2>
                <ul>
                  {prefazione.map((item) => (
                    <li>
                      <strong set:html={inlineMd(item.titolo || labels.defaultPrefaceTitle)} />
                      {item.autore && <em>{item.autore}</em>}
                      <a href={item.pdf} target="_blank" rel="noopener noreferrer">
                        {labels.pdf}
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            )
          }

          {
            editoriale.length > 0 && (
              <section>
                <h2>{labels.editorial}</h2>
                <ul>
                  {editoriale.map((item) => (
                    <li>
                      <strong set:html={inlineMd(item.titolo || labels.defaultEditorialTitle)} />
                      {item.autore && <em>{item.autore}</em>}
                      <a href={item.pdf} target="_blank" rel="noopener noreferrer">
                        {labels.pdf}
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            )
          }

          {
            articoli.length > 0 && (
              <section>
                <h2>{labels.articles}</h2>
                <ol>
                  {articoli.map((item) => (
                    <li>
                      <strong set:html={inlineMd(item.titolo || "")} />
                      {item.autore && <em>{item.autore}</em>}
                      <a href={item.pdf} target="_blank" rel="noopener noreferrer">
                        {labels.pdf}
                      </a>
                    </li>
                  ))}
                </ol>
              </section>
            )
          }

          {
            workingPaper.length > 0 && (
              <section>
                <h2>{labels.workingPapers}</h2>
                <ol>
                  {workingPaper.map((item) => (
                    <li>
                      <strong set:html={inlineMd(item.titolo || "")} />
                      {item.autore && <em>{item.autore}</em>}
                      <a href={item.pdf} target="_blank" rel="noopener noreferrer">
                        {labels.pdf}
                      </a>
                    </li>
                  ))}
                </ol>
              </section>
            )
          }

          {
            recensioni.length > 0 && (
              <section>
                <h2>{labels.reviews}</h2>
                <ol>
                  {recensioni.map((item) => (
                    <li>
                      <strong set:html={inlineMd(item.titolo || "")} />
                      {item.autore && <em>{item.autore}</em>}
                      <a href={item.pdf} target="_blank" rel="noopener noreferrer">
                        {labels.pdf}
                      </a>
                    </li>
                  ))}
                </ol>
              </section>
            )
          }

          <slot />
        </div>
      </main>
    </div>
  </div>
</Layout>

<style>
  .volume-container {
    max-width: 1100px;
    margin: 3rem auto;
    padding: 0 1rem;
  }

  .volume-grid {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 4rem;
    align-items: start;
  }

  /* Left Column */
  .volume-sidebar {
    position: sticky;
    top: 120px; /* Adjust based on sticky header height */
  }

  .volume-cover-img {
    width: 100%;
    height: auto;
    display: block;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
    border: 1px solid #eee;
  }

  .volume-action {
    margin-top: 1.5rem;
    text-align: center;
  }

  .btn-download-full {
    display: inline-block;
    width: 100%;
    padding: 0.8rem 1rem;
    background-color: #000;
    color: #fff;
    text-decoration: none;
    font-weight: 500;
    text-transform: uppercase;
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    transition: background-color 0.2s;
  }

  .btn-download-full:hover {
    background-color: #333;
    text-decoration: none;
    color: #fff;
  }

  /* Right Column */
  .volume-header-detail {
    margin-bottom: 3rem;
    border-bottom: 1px solid #eee;
    padding-bottom: 2rem;
  }

  .volume-year-label {
    display: block;
    font-family:
      -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: #888;
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }

  .volume-title-main {
    font-family: Palatino, "Palatino Linotype", "Book Antiqua", serif;
    font-size: 2.5rem;
    line-height: 1.1;
    margin-bottom: 1rem;
    color: #111;
  }

  .volume-description-main {
    font-family: Palatino, "Palatino Linotype", "Book Antiqua", serif;
    font-size: 1.2rem;
    color: #444;
    line-height: 1.5;
  }

  /* TOC Sections — match the markdown-derived original styles */
  .volume-toc-content h2 {
    font-family: Palatino, "Palatino Linotype", "Book Antiqua", serif;
    font-size: 1.5rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    border-bottom: 1px dotted #ccc;
    padding-bottom: 0.5rem;
    color: #000;
  }

  .volume-toc-content ul {
    list-style: none;
    padding: 0;
  }

  .volume-toc-content li {
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }

  .volume-toc-content strong {
    display: block;
    color: #222;
    font-size: 1.05rem;
  }

  .volume-toc-content em {
    color: #555;
    font-style: normal;
    display: block;
    margin-bottom: 0.25rem;
  }

  .volume-toc-content a {
    color: #000;
    text-decoration: underline;
    font-size: 0.9rem;
  }

  .volume-toc-content a:hover {
    text-decoration: none;
    color: #444;
  }

  /* Numbered lists for Articles */
  .volume-toc-content ol {
    list-style-type: decimal;
    padding-left: 1.5rem;
  }

  .volume-toc-content ol li {
    margin-bottom: 2rem;
    padding-left: 0.5rem;
  }

  /* Markdown body (legacy notes still in slot) */
  .volume-toc-content :global(h2) {
    font-family: Palatino, "Palatino Linotype", "Book Antiqua", serif;
    font-size: 1.5rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    border-bottom: 1px dotted #ccc;
    padding-bottom: 0.5rem;
    color: #000;
  }

  .volume-toc-content :global(ul) {
    list-style: none;
    padding: 0;
  }

  .volume-toc-content :global(li) {
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }

  .volume-toc-content :global(strong) {
    display: block;
    color: #222;
    font-size: 1.05rem;
  }

  .volume-toc-content :global(em) {
    color: #555;
    font-style: normal;
    display: block;
    margin-bottom: 0.25rem;
  }

  .volume-toc-content :global(a) {
    color: #000;
    text-decoration: underline;
    font-size: 0.9rem;
  }

  .volume-toc-content :global(a:hover) {
    text-decoration: none;
    color: #444;
  }

  .volume-toc-content :global(ol) {
    list-style-type: decimal;
    padding-left: 1.5rem;
  }

  .volume-toc-content :global(ol li) {
    margin-bottom: 2rem;
    padding-left: 0.5rem;
  }

  @media (max-width: 768px) {
    .volume-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .volume-sidebar {
      position: static;
      max-width: 250px;
      margin: 0 auto;
    }
  }
</style>
