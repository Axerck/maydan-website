---
import Layout from "../../layouts/Layout.astro";
import homepageData from "../../data/homepage-en.json";
import { inlineMd } from "../../lib/inline-md";
import callData from "../../data/call-e-linee-guida-en.json";
import type { HomepageData, CallELineeGuidaData } from "../../data/types";

const data = homepageData as HomepageData;
// Il riquadro in cima mostra la call attiva della pagina «Call»: si aggiorna in un posto solo
const call = (callData as CallELineeGuidaData).active_call;
---

<Layout
  title="Maydan – Journal of Arab, Semitic and Islamic Worlds"
  description="Official site of the academic journal Maydan, dedicated to studies on the Arab, Semitic, and Islamic worlds."
>
  <!-- Call for Papers / Hero Section -->
  <section class="hero" id="call-linee-guida">
    <div class="hero-inner">
      <div class="hero-layout">
        <div class="hero-text">
          <h2>{call.title}</h2>
          <p>
            {call.deadlines.map((d, i) => (
              <Fragment><Fragment set:html={inlineMd(d)} />{i < call.deadlines.length - 1 && <br />}</Fragment>
            ))}
          </p>
          <a
            href={call.pdf_link}
            class="btn-primary"
            target="_blank">Download the Call (PDF)</a
          >
          {call.more_link && (
            <a href={call.more_link} class="card-link" style="margin-left: 1rem"
              >{call.more_label || "Read more"} &rarr;</a
            >
          )}
        </div>
        <div class="hero-image">
          <img
            src={call.image}
            alt={call.image_alt}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Main Blocks -->
  <section class="home-grid">
    <!-- Latest Issue -->
    <article class="home-card" id="numeri">
      <h2>{data.latest_issue_card.title}</h2>
      <div class="card-images">
        <img
          src={data.latest_issue_card.image}
          alt={data.latest_issue_card.image_alt}
        />
      </div>
      <p>{data.latest_issue_card.description}</p>
      <a href={data.latest_issue_card.link} class="card-link">{data.latest_issue_card.link_label} &rarr;</a>
    </article>

    <!-- Editorial Board Statement -->
    <article class="home-card">
      <div class="card-images">
        <img src={data.comunicato_card.image} alt={data.comunicato_card.image_alt} />
      </div>
      <h2>{data.comunicato_card.title}</h2>
      <p>{data.comunicato_card.description}</p>
      <a href={data.comunicato_card.link} class="card-link">{data.comunicato_card.link_label} &rarr;</a>
    </article>

    <!-- Other Activities -->
    <section class="home-card" id="attivita">
      <h2>{data.activities_card.title}</h2>
      <ul class="activity-list">
        {data.activities_card.items.map((item) => (
          <li>
            {item.link ? (
              <a href={item.link}>{item.label}</a>
            ) : (
              item.label
            )}
          </li>
        ))}
      </ul>
      <a href={data.activities_card.main_link} class="card-link">{data.activities_card.main_link_label} &rarr;</a
      >

      {data.activities_card.altro_section &&
        data.activities_card.altro_section.items &&
        data.activities_card.altro_section.items.length > 0 && (
          <div class="altro-section">
            <h3>{data.activities_card.altro_section.title}</h3>
            <ul class="activity-list">
              {data.activities_card.altro_section.items.map((item) => (
                <li>
                  {item.link ? (
                    <a href={item.link}>{item.label}</a>
                  ) : (
                    item.label
                  )}
                </li>
              ))}
            </ul>
          </div>
        )}
    </section>
  </section>

  <style>
    .altro-section {
      margin-top: 2rem;
      padding-top: 1.5rem;
      border-top: 1px solid #eee;
    }

    .altro-section h3 {
      font-family: Palatino, "Palatino Linotype", "Book Antiqua", serif;
      font-size: 1.05rem;
      margin: 0 0 0.8rem;
      color: #333;
      text-transform: none;
      font-weight: bold;
    }
  </style>

  <!-- Collaborations -->
  <section class="collaborazioni">
    <h2>{data.collaborations.title}</h2>
    <div class="collab-logos">
      {data.collaborations.logos.map((logo) => (
        <a
          href={logo.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          <img
            src={logo.image}
            alt={`${logo.name} Logo`}
            style="max-width: 120px; height: auto;"
          />
        </a>
      ))}
    </div>
  </section>
</Layout>
