---
import Layout from "../../../layouts/Layout.astro";
import callData from "../../../data/call-e-linee-guida-en.json";
import type { CallELineeGuidaData } from "../../../data/types";

const data = callData as CallELineeGuidaData;
---

<Layout
	title="Calls & Guidelines | Maydan Journal"
	description="Discover the current and past Call for Papers of the Maydan journal. Consult the guidelines for authors and the code of ethics."
>
	<!-- <h1>Call & Linee Guida</h1> -->

	<section class="home-card">
		<h2>{data.active_call.section_title}</h2>
		<article class="call-item">
			<div class="call-image">
				<img src={data.active_call.image} alt={data.active_call.image_alt} />
			</div>
			<div class="call-content">
				<header>
					<h3>
						<a href={data.active_call.pdf_link}>{data.active_call.title}</a>
					</h3>
				</header>
				<p class="scadenze">
					{
						data.active_call.deadlines.map((d, i) => (
							<Fragment>
								✦ {d}
								{i < data.active_call.deadlines.length - 1 && <br />}
							</Fragment>
						))
					}
				</p>
				<!-- <p>Descrizione call</p> -->
			</div>
		</article>
	</section>

	<br />

	<section class="home-card">
		<h2>{data.linee_guida.section_title}</h2>

		<ul class="documents-list">
			{
				data.linee_guida.documents.map((doc) => (
					<li>
						<a href={doc.pdf} target="_blank">
							{doc.label}
						</a>
					</li>
				))
			}
		</ul>
	</section>

	<style>
		.documents-list {
			list-style: none;
			padding: 0;
			margin-top: 1.5rem;
		}

		.documents-list li {
			margin-bottom: 0.8rem;
		}

		.documents-list a {
			display: inline-block;
			color: #333;
			text-decoration: none;
			border-left: 3px solid #000;
			padding-left: 10px;
			transition:
				color 0.2s,
				border-left-color 0.2s;
		}

		.documents-list a:hover {
			color: #000;
			border-left-color: #555;
			text-decoration: underline;
		}
	</style>

	<br />

	<section class="past-calls">
		<h2>{data.past_calls.section_title}</h2>

		<div class="call-list">
			{
				data.past_calls.items.map((item) => (
					<article class="call-item">
						<div class="call-image">
							<img src={item.image} alt={item.image_alt} />
						</div>
						<div class="call-content">
							<h3>
								<a href={item.pdf_link}>{item.title}</a>
							</h3>
						</div>
					</article>
				))
			}
		</div>
	</section>

	<style>
		.past-calls {
			max-width: 900px;
			margin: 4rem auto;
			padding: 0 1rem;
		}

		.past-calls h2 {
			font-family: Palatino, "Palatino Linotype", "Book Antiqua", serif;
			font-size: 1.8rem;
			margin-bottom: 2rem;
			border-bottom: 2px solid #000;
			padding-bottom: 0.5rem;
			display: inline-block;
		}

		.call-list {
			display: flex;
			flex-direction: column;
		}

		.call-item {
			display: flex;
			align-items: center;
			gap: 2rem;
			padding: 2rem 0;
			border-bottom: 1px solid #000;
		}

		.call-item:last-child {
			border-bottom: none;
		}

		.call-image {
			flex: 0 0 300px; /* Fixed width for image column */
			width: 300px;
		}

		.call-image img,
		.placeholder-img {
			width: 100%;
			height: auto;
			display: block;
			aspect-ratio: 16/9;
			object-fit: cover;
			border: 1px solid #ddd;
		}

		.placeholder-img {
			display: flex;
			align-items: center;
			justify-content: center;
			color: #777;
			font-size: 0.9rem;
		}

		.call-content {
			flex: 1;
		}

		.call-content h3 {
			font-family: Palatino, "Palatino Linotype", "Book Antiqua", serif;
			font-size: 1.1rem;
			margin: 0;
			text-transform: uppercase;
			font-weight: bold;
			line-height: 1.4;
		}

		.call-content h3 a {
			color: #000;
			text-decoration: underline;
			text-underline-offset: 4px;
		}

		.call-content h3 a:hover {
			color: #555;
		}

		@media (max-width: 768px) {
			.call-item {
				flex-direction: column;
				align-items: flex-start;
				gap: 1rem;
			}

			.call-image {
				flex: 0 0 auto;
				width: 100%;
				max-width: 100%;
			}
		}
	</style>
</Layout>
