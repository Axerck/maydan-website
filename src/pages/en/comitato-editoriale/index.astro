---
import Layout from "../../../layouts/Layout.astro";
import { corrente, passati } from "../../../lib/comitati";
import teamData from "../../../data/team.json";

const teamMembers = teamData.members;

// Mapping Italian titles to English
const roleTranslations: Record<string, string> = {
  "Direttore responsabile": "Editor-in-Chief",
  "Direttrice responsabile": "Editor-in-Chief",
  Vicedirettrice: "Deputy Editor",
  Vicedirettore: "Deputy Editor",
  Caporedattrice: "Managing Editor",
  Redazione: "Editorial Board",
  Tesoriere: "Treasurer",
  Tirocinanti: "Interns",
  Collaboratori: "Collaborators",
  Collaboratrici: "Collaborators",
};

const translateTitle = (title: string) => roleTranslations[title] || title;
---

<Layout
  title="Editorial Board - Maydan Journal"
  description="The members of the editorial board of the Maydan journal: editors, editorial staff, and collaborators."
>
  {
    corrente.groups
      .filter((group) => group.members.some((m) => teamMembers.some((t) => t.slug === m.slug)))
      .map((group) => (
      <section class="committee-section">
        <h2>{group.title_en || translateTitle(group.title)}</h2>
        <ul>
          {group.members.map((memberStruct) => {
            const memberData = teamMembers.find(
              (m) => m.slug === memberStruct.slug,
            );
            if (!memberData) return null;

            return (
              <li>
                <strong>
                  <a href={`/en/comitato-editoriale/${memberData.slug}`}>
                    {memberData.name}
                  </a>
                </strong>
                {(memberData.affiliation_en || memberData.affiliation) && ` – `}
                {(memberData.affiliation_en || memberData.affiliation) && <em>{memberData.affiliation_en || memberData.affiliation}</em>}
              </li>
            );
          })}
        </ul>
        <hr />
      </section>
    ))
  }

  <section class="committee-section">
    <h2>Past Editorial Boards</h2>
    <ul>
      {
        passati.map((board) => (
          <li>
            <strong>
              <a href={`/en/comitato-editoriale/archivio/${board.year}`}>
                {board.year} Editorial Board
              </a>
            </strong>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
