---
import Layout from "../../layouts/Layout.astro";
import homepageData from "../../data/homepage-it.json";
import type { HomepageData } from "../../data/types";

const data = homepageData as HomepageData;
---

<Layout
  title="Maydan – Rivista sui mondi arabi, semitici e islamici"
  description="Sito ufficiale della rivista accademica Maydan, dedicato agli studi sui mondi arabi, semitici e islamici."
>
  <!-- Sezione Call for Papers / Hero -->
  <section class="hero" id="call-linee-guida">
    <div class="hero-inner">
      <div class="hero-layout">
        <div class="hero-text">
          <h2>{data.hero.title}</h2>
          <p>
            <strong>{data.hero.deadline_abstract_label}</strong> {data.hero.deadline_abstract}<br />
            <strong>{data.hero.deadline_paper_label}</strong> {data.hero.deadline_paper}
          </p>
          <a
            href={data.hero.pdf_link}
            class="btn-primary"
            target="_blank">{data.hero.pdf_button_label}</a
          >
        </div>
        <div class="hero-image">
          <img
            src={data.hero.image}
            alt={data.hero.image_alt}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Blocchi principali -->
  <section class="home-grid">
    <!-- Ultimo numero -->
    <article class="home-card" id="numeri">
      <h2>{data.latest_issue_card.title}</h2>
      <div class="card-images">
        <img
          src={data.latest_issue_card.image}
          alt={data.latest_issue_card.image_alt}
        />
      </div>
      <p>{data.latest_issue_card.description}</p>
      <a href={data.latest_issue_card.link} class="card-link"
        >{data.latest_issue_card.link_label} &rarr;</a
      >
    </article>

    <!-- Comunicato -->
    <article class="home-card">
      <div class="card-images">
        <img src={data.comunicato_card.image} alt={data.comunicato_card.image_alt} />
      </div>
      <h2>{data.comunicato_card.title}</h2>
      <p>{data.comunicato_card.description}</p>
      <a href={data.comunicato_card.link} class="card-link">{data.comunicato_card.link_label} &rarr;</a>
    </article>

    <!-- Altre attività -->
    <section class="home-card" id="attivita">
      <h2>{data.activities_card.title}</h2>
      <ul class="activity-list">
        {data.activities_card.items.map((item) => (
          <li>
            {item.link ? (
              <a href={item.link}>{item.label}</a>
            ) : (
              item.label
            )}
          </li>
        ))}
      </ul>
      <a href={data.activities_card.main_link} class="card-link">{data.activities_card.main_link_label} &rarr;</a>

      {data.activities_card.altro_section &&
        data.activities_card.altro_section.items &&
        data.activities_card.altro_section.items.length > 0 && (
          <div class="altro-section">
            <h3>{data.activities_card.altro_section.title}</h3>
            <ul class="activity-list">
              {data.activities_card.altro_section.items.map((item) => (
                <li>
                  {item.link ? (
                    <a href={item.link}>{item.label}</a>
                  ) : (
                    item.label
                  )}
                </li>
              ))}
            </ul>
          </div>
        )}
    </section>
  </section>

  <style>
    .altro-section {
      margin-top: 2rem;
      padding-top: 1.5rem;
      border-top: 1px solid #eee;
    }

    .altro-section h3 {
      font-family: Palatino, "Palatino Linotype", "Book Antiqua", serif;
      font-size: 1.05rem;
      margin: 0 0 0.8rem;
      color: #333;
      text-transform: none;
      font-weight: bold;
    }
  </style>

  <!-- Collaborazioni -->
  <section class="collaborazioni">
    <h2>{data.collaborations.title}</h2>
    <div class="collab-logos">
      {data.collaborations.logos.map((logo) => (
        <a
          href={logo.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          <img
            src={logo.image}
            alt={`Logo ${logo.name}`}
            style="max-width: 120px; height: auto;"
          />
        </a>
      ))}
    </div>
  </section>
</Layout>
