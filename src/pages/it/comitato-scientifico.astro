---
import Layout from "../../layouts/Layout.astro";
import comitato from "../../data/comitato-scientifico.json";

// Elenco modificabile dal CMS (Comitato scientifico → src/data/comitato-scientifico.json)
const membri = comitato.members;
---

<Layout
	title="Comitato Scientifico - Rivista Maydan"
	description="Membri del comitato scientifico internazionale della rivista Maydan, provenienti da diverse università italiane ed estere."
>
	<ul class="committee-list">
		{
			membri.map((m) => (
				<li>
					<strong>
						{m.url ? (
							<a href={m.url} target="_blank" rel="noopener">
								{m.name}
							</a>
						) : (
							m.name
						)}
					</strong>
					{(m.affiliation) && <Fragment> – <em>{m.affiliation}</em></Fragment>}
				</li>
			))
		}
	</ul>
</Layout>
