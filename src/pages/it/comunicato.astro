---
import Layout from "../../layouts/Layout.astro";
import { marked } from "marked";
// Testo modificabile dal CMS (Pagine del sito → Comunicato): una sezione per lingua
import data from "../../data/pagine/comunicato.json";

type Sezione = { lang_title: string; rtl?: boolean; heading?: string; body: string; pdf?: string; pdf_label?: string };
const sezioni = data.sections as Sezione[];
---

<Layout title={data.seo_title} description={data.seo_description}>
    <section class="comunicato-container">
        <header class="page-header">
            <div class="header-image">
                <img src={data.image} alt={data.image_alt} />
            </div>
            <div class="header-title">
                <h1>{data.title}</h1>
            </div>
        </header>

        <div class="comunicato-content text-justify">
            {
                sezioni.map((s, i) => {
                    const corpo = (
                        <Fragment>
                            {s.heading && (
                                <div class="page-header arabic-header">
                                    <div class="header-image">
                                        <img src={data.image} alt={data.image_alt} />
                                    </div>
                                    <div class="header-title">
                                        <h3 class="arabic-heading">{s.heading}</h3>
                                    </div>
                                </div>
                            )}
                            <Fragment set:html={marked.parse(s.body || "")} />
                            {s.pdf && (
                                <div class="download-block">
                                    <a href={s.pdf} target="_blank" class="download-btn">
                                        📥 {s.pdf_label}
                                    </a>
                                </div>
                            )}
                        </Fragment>
                    );
                    return (
                        <Fragment>
                            {i > 0 && <hr class="separator" />}
                            <h2 class={`lang-title${s.rtl ? " text-right" : ""}`} dir={s.rtl ? "rtl" : undefined}>
                                {s.lang_title}
                            </h2>
                            {s.rtl ? <div class="arabic-text" dir="rtl">{corpo}</div> : corpo}
                        </Fragment>
                    );
                })
            }
        </div>
    </section>
</Layout>

<style>
    :global(html),
    :global(body) {
        background-color: white !important;
    }

    .comunicato-container {
        max-width: 800px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
    }

    .page-header {
        display: flex;
        align-items: center;
        gap: 2rem;
        margin-bottom: 3rem;
        border-bottom: 1px solid #eee;
        padding-bottom: 2rem;
    }

    .header-image img {
        max-width: 15rem;
        height: auto;
        transform: rotate(-15deg);
    }

    .header-title h1 {
        font-family: Palatino, "Palatino Linotype", "Book Antiqua", serif;
        font-size: 2rem;
        margin: 0;
        text-align: left;
        color: #111;
    }

    @media (max-width: 768px) {
        .page-header {
            flex-direction: column;
            text-align: center;
        }

        .header-title h1 {
            text-align: center;
            font-size: 1.8rem;
        }

        .header-image img {
            max-width: 12rem;
            transform: none;
        }
    }

    .comunicato-content {
        font-size: 1.1rem;
        line-height: 1.8;
        color: #333;
    }

    .lang-title {
        font-family: Palatino, "Palatino Linotype", "Book Antiqua", serif;
        font-size: 1.6rem;
        margin: 2rem 0 1rem;
        color: #000;
        border-bottom: 1px solid #eee;
        padding-bottom: 0.5rem;
    }

    .separator {
        border: 0;
        height: 1px;
        background: #ddd;
        margin: 3rem 0;
    }

    .arabic-text {
        font-family: "Traditional Arabic", "Amiri", serif;
        font-size: 1.3rem;
        line-height: 2;
    }

    .arabic-heading {
        font-weight: bold;
        margin-bottom: 0;
        font-size: 1.6rem;
    }

    .arabic-header .header-image img {
        transform: rotate(-15deg);
    }

    .text-right {
        text-align: right;
    }

    .download-block {
        margin: 1.5rem 0;
    }

    .download-btn {
        display: inline-block;
        font-weight: bold;
        color: #000;
        text-decoration: none;
        border-bottom: 2px solid #000;
        transition: all 0.2s ease;
    }

    .download-btn:hover {
        background-color: #000;
        color: #fff;
    }
</style>
